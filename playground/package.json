{
  "name": "gs1-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "server": "node --import tsx server/index.ts",
    "dev:server": "node --watch --import tsx server/index.ts",
    "start": "node --import tsx server/index.ts",
    "test:server": "node --import tsx --test server/tests/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "^22.20.4",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "@vitejs/plugin-react": "4.4.1",
    "tsx": "^4.23.15",
    "typescript": "5.8.3",
    "vite": "6.4.5"
  }
}
